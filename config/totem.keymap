/*
 * Totem 38-key keymap
 *
 * Migration from a 42-key Corne:
 * - Base alpha positions preserved as much as possible.
 * - Left home-row extra: CTRL
 * - Right home-row extra: BACKSPACE
 * - Left thumb: GUI / LOWER / SPACE
 * - Right thumb: ENTER / RAISE / ALT
 *
 * Suggested combos:
 * - W + E = TAB
 * - S + D = ESC
 * - X + C = LEFT SHIFT
 * - ; + ' = APOSTROPHE
 *
 * NOTE:
 * The exact physical-node ordering depends on your Totem shield/board.dtsi.
 * This keymap assumes the common 3x5+2? Totem ordering represented as
 * 12 keys per half: 5 top + 6 home/bottom? If your shield uses a different
 * ordering, adjust the bindings order to match its matrix.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            timeout-ms = <200>;
            key-positions = <1 2>;
            bindings = <&kp TAB>;
        };

        esc {
            timeout-ms = <200>;
            key-positions = <7 8>;
            bindings = <&kp ESC>;
        };

        shift {
            timeout-ms = <200>;
            key-positions = <11 12>;
            bindings = <&kp LSHFT>;
        };

        apostrophe {
            timeout-ms = <200>;
            key-positions = <22 23>;
            bindings = <&kp APOS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                // Left half: 5 top + 6 home/bottom, then right half
                &kp Q       &kp W       &kp E       &kp R       &kp T
                &kp LCTRL  &kp A       &kp S       &kp D       &kp F       &kp G
                &kp Z      &kp X       &kp C       &kp V       &kp B

                &kp Y       &kp U       &kp I       &kp O       &kp P
                &kp BSPC   &kp H       &kp J       &kp K       &kp L       &kp SEMI
                &kp N      &kp M       &kp COMMA   &kp DOT     &kp FSLH

                &kp LGUI   &mo 2       &kp SPACE
                &kp RET    &mo 1       &kp RALT
            >;
        };

        nav_num {
            bindings = <
                &kp N1      &kp N2      &kp N3      &kp N4      &kp N5
                &kp TAB     &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &trans
                &kp N6      &kp N7      &kp N8      &kp N9      &kp N0

                &kp N6      &kp N7      &kp N8      &kp N9      &kp N0
                &trans      &trans      &trans      &trans      &trans      &trans
                &kp MINUS   &kp PLUS    &kp EQUAL   &kp STAR    &kp FSLH

                &trans      &trans      &kp SPACE
                &kp RET     &trans      &kp RALT
            >;
        };

        sym_func {
            bindings = <
                &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT
                &kp TAB     &kp MINUS   &kp EQUAL   &kp LBKT    &kp RBKT    &kp BSLH
                &kp CARET   &kp AMPS    &kp ASTRK   &kp LPAR    &kp RPAR

                &kp CARET   &kp AMPS    &kp ASTRK   &kp LPAR    &kp RPAR
                &kp GRAVE   &kp LBRC    &kp RBRC    &kp PIPE    &kp TILDE   &trans
                &kp UNDER   &kp PLUS    &kp LBRC    &kp RBRC    &kp BSLH

                &kp LGUI    &trans      &kp SPACE
                &kp RET     &trans      &kp RALT
            >;
        };

        device {
            bindings = <
                &none       &kp C_BRIGHTNESS_DEC &kp C_BRIGHTNESS_INC &none &none
                &kp K_MUTE  &kp C_VOLUME_DOWN    &kp C_VOLUME_UP      &kp C_PLAY_PAUSE &none &none
                &none       &none                 &none                &none             &none

                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                &none        &none        &none        &none        &none        &none
                &none        &none        &none        &none        &none        &bt BT_CLR

                &none &none &none
                &none &none &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
